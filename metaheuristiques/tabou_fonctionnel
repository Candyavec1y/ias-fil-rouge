        patients_ids = par_vacation[vacation_id]
        n_ambulatoire = sum(instance2.patients[pid].ambulatoire for pid in patients_ids)
        charge = sum(instance2.patients[pid].duree_bloc_minutes for pid in patients_ids)
        capacite = capacite_effective_vacation(vacation)
