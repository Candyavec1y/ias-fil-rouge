def construire_patients_etude(vacations, rng=None):
    tirage = rng if rng is not None else random.Random(GRAINE_PATIENTS)
    capacite_par_chir: dict[int, float] = {}
    for v in vacations.values():
        capacite_par_chir[v.chirurgien_id] = capacite_par_chir.get(v.chirurgien_id, 0) + duree_vacation_minutes(v)

    prenoms = ["Léo", "Emma", "Hugo", "Alice", "Noah", "Léa", "Jules", "Chloé", "Louis", "Zoé",
               "Gabriel", "Inès", "Adam", "Jade", "Raphaël", "Louise", "Arthur", "Anna", "Nathan", "Camille",
               "Sacha", "Mila", "Tom", "Rose", "Ethan", "Iris", "Marius", "Nina"]
    durees_possibles = [30, 45, 60, 75, 90, 105, 120, 150]
    patients, patient_id = {}, 1

    for chirurgien_id, capacite in sorted(capacite_par_chir.items()):
        objectif = capacite * tirage.uniform(0.90, 1.10)
        generees = 0.0
        while generees < objectif:
            restant = objectif - generees
            if restant < durees_possibles[0]:
                break
            candidats = [d for d in durees_possibles if d <= restant + 15]
            duree = tirage.choice(candidats or [durees_possibles[0]])
            type_intervention = tirage.choices(
                TYPES_INTERVENTION, weights=[0.25, 0.45, 0.15, 0.15], k=1
            )[0]
            priorite = tirage.choices([1, 2, 3, 4], weights=[0.15, 0.50, 0.25, 0.10], k=1)[0]
            urgence = tirage.random() < 0.05
            if urgence:
                priorite = 4
            ambulatoire = tirage.random() < 0.40
            if ambulatoire:
                pre, post = 0, 0
            else:
                pre = 1 if tirage.random() < 0.30 else 0
                post = tirage.choice([1, 1, 2, 2, 3])
            patients[patient_id] = Patient(
                id=patient_id, nom=tirage.choice(prenoms), age=tirage.randint(5, 90),
                sexe=tirage.choice(["F", "M"]), chirurgien_id=chirurgien_id,
                specialite=SPECIALITES_PAR_CHIRURGIEN.get(chirurgien_id, "Chirurgie générale"),
                ambulatoire=ambulatoire, duree_bloc_minutes=duree, nuits_pre_op=pre, nuits_post_op=post,
                type_intervention=type_intervention, priorite=priorite, urgence=urgence)
            generees += duree
            patient_id += 1
    return attribuer_scores_urgence(patients)


# Trois instances emboitees : Petite est incluse dans Moyenne, elle-meme incluse
# dans Grande. La comparaison mesure donc l'effet du volume, pas trois tirages
# independants de difficulte differente.
INSTANCES_BENCHMARK = {
    "Petite": {"nombre_patients": 50, "seed": 2026},
    "Moyenne": {"nombre_patients": 100, "seed": 2026},
    "Grande": {"nombre_patients": 200, "seed": 2026},
}
DUREES_BENCHMARK = CALIBRATION_SOURCE["durees"]
POIDS_DUREES_BENCHMARK = CALIBRATION_SOURCE["poids_durees"]
POIDS_TYPES_BENCHMARK = CALIBRATION_SOURCE["poids_types"]


def construire_patients_benchmark(vacations: dict[int, Vacation], nombre_patients: int,
                                  seed: int) -> dict[int, Patient]:
    """Adaptation du générateur joint au modèle bloc/lits/places.

    Le chirurgien est tiré au prorata de sa capacité régulière, comme dans le
    générateur fourni. Les attributs de séjour sont nécessaires uniquement aux
    contraintes de lits/places du présent solveur.
    """
    rng = random.Random(seed)
    capacites: dict[int, float] = {}
    noms: dict[int, str] = {}
    for v in vacations.values():
        if not v.supplementaire:
            capacites[v.chirurgien_id] = capacites.get(v.chirurgien_id, 0.0) + duree_vacation_minutes(v)
    # Les noms sont les codes anonymises de la feuille de vacations. La demande
    # historique 2021 controle le tirage ; la capacite source sert de repli pour
    # un code nouveau ou absent de l'historique.
    for cid in capacites:
        noms[cid] = str(cid)
    chirurgiens = sorted(capacites)
    # L'ordre des identifiants suit l'ordre alphabetique choisi par le builder.
    codes = sorted(CALIBRATION_SOURCE["besoin_hebdo_par_chirurgien"])
    nom_par_id = {i + 1: code for i, code in enumerate(codes)}
    poids_chirurgiens = [
        CALIBRATION_SOURCE["besoin_hebdo_par_chirurgien"].get(
            nom_par_id.get(cid, ""), max(1.0, capacites[cid] / 10.0)
        ) for cid in chirurgiens
    ]
    patients = {}
    for pid in range(1, nombre_patients + 1):
        cid = rng.choices(chirurgiens, weights=poids_chirurgiens, k=1)[0]
        type_intervention = rng.choices(
            CALIBRATION_SOURCE["types"],
            weights=POIDS_TYPES_BENCHMARK, k=1,
        )[0]
        duree = rng.choices(DUREES_BENCHMARK, weights=POIDS_DUREES_BENCHMARK, k=1)[0]
        priorite = rng.choices([1, 2, 3, 4], weights=[0.15, 0.50, 0.25, 0.10], k=1)[0]
        urgence = rng.random() < 0.05
        if urgence:
            priorite = 4
        proba_ambu = CALIBRATION_SOURCE["proba_ambu"][type_intervention]
        ambulatoire = rng.random() < proba_ambu
        pre = 0 if ambulatoire else rng.choices(
            CALIBRATION_SOURCE["pre_valeurs"], weights=CALIBRATION_SOURCE["pre_poids"], k=1,
        )[0]
        post = 0 if ambulatoire else rng.choices(
            CALIBRATION_SOURCE["post_valeurs"], weights=CALIBRATION_SOURCE["post_poids"], k=1,
        )[0]
        # Quantiles d'age observes : interpolation par segments, sans reprendre
        # la date de naissance ni l'identifiant d'un patient source.
        age = int(round(rng.triangular(5, 98, 54)))
        patients[pid] = Patient(
            id=pid, nom=f"Patient {pid:04d}", age=age,
            sexe=rng.choices(["F", "M"], weights=[7324, 7153], k=1)[0],
            chirurgien_id=cid, specialite="Non renseignée dans la grille de vacations",
            ambulatoire=ambulatoire, duree_bloc_minutes=duree, nuits_pre_op=pre, nuits_post_op=post,
            type_intervention=type_intervention, priorite=priorite, urgence=urgence,
        )
    return attribuer_scores_urgence(patients)


def diagnostic_coherence_chirurgiens(instance1: InstanceProbleme, instance2: InstanceNiveau2,
                                     semaines_extra: int = 1) -> list[dict]:
    """Audit de cohérence demande/capacité avant et après ouverture possible.

    La capacité « horizon » est une borne haute constructive : les créneaux libres
    sont attribués une seule fois, au chirurgien présentant le plus fort déficit.
    Elle ne remplace pas la validation lits/places, évaluée séparément.
    """
    demande = {cid: 0.0 for cid in instance1.chirurgiens}
    nb_patients = {cid: 0 for cid in instance1.chirurgiens}
    for p in instance2.patients.values():
        demande[p.chirurgien_id] = demande.get(p.chirurgien_id, 0.0) + p.duree_bloc_minutes
        nb_patients[p.chirurgien_id] = nb_patients.get(p.chirurgien_id, 0) + 1
    capacite_reg = {cid: 0.0 for cid in instance1.chirurgiens}
    occupe = set()
    for v in instance2.vacations.values():
        if v.supplementaire:
            continue
        capacite_reg[v.chirurgien_id] += capacite_effective_vacation(v)
        for cid in v.creneaux_ids:
            occupe.add((0, v.salle_id, cid))
    # Attribution gloutonne des créneaux non occupés, en respectant la salle et la disponibilité.
    horizon = dict(capacite_reg)
    plages = {(p.salle_id, p.creneau_id): p.type_plage for p in instance1.plages_bloc.values()}
    creneaux = sorted(instance1.creneaux.values(), key=lambda c: (c.jour, c.heure_debut, c.id))
    for semaine in range(semaines_extra + 1):
        for creneau in creneaux:
            for salle in instance1.salles:
                if plages.get((salle, creneau.id)) != "LIBRE" or (semaine, salle, creneau.id) in occupe:
                    continue
                candidats = []
                for chir in instance1.chirurgiens.values():
                    disponible = instance1.disponibilites_chirurgiens.get(chir.id)
                    if salle in chir.salles_autorisees and (disponible is None or creneau.id in disponible):
                        candidats.append(chir.id)
                if not candidats:
                    continue
                choisi = max(candidats, key=lambda cid: demande.get(cid, 0.0) - horizon.get(cid, 0.0))
                if demande.get(choisi, 0.0) > horizon.get(choisi, 0.0):
                    horizon[choisi] += creneau.duree_minutes * (1 - MARGE_ALEA_VACATION)
                    occupe.add((semaine, salle, creneau.id))
    lignes = []
    for cid, chirurgien in instance1.chirurgiens.items():
        d, c, h = demande.get(cid, 0.0), capacite_reg.get(cid, 0.0), horizon.get(cid, 0.0)
        moyenne = d / nb_patients[cid] if nb_patients[cid] else 0.0
        if d <= c + 1e-9:
            verdict = "COHÉRENT sans vacation supplémentaire"
        elif d <= h + 1e-9:
            verdict = "COHÉRENT avec vacations supplémentaires"
        else:
            verdict = "INCOHÉRENT sur l'horizon : capacité insuffisante"
        lignes.append({
            "Chirurgien": chirurgien.nom,
            "Patients": nb_patients[cid],
            "Demande min": round(d, 1),
            "Capacité régulière min": round(c, 1),
            "Ratio demande/capacité": round(d / c, 2) if c else None,
            "Capacité max horizon min": round(h, 1),
            "Patients théoriques réguliers": int(c // moyenne) if moyenne else 0,
            "Verdict": verdict,
        })
    return lignes


