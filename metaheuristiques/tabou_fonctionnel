<script>const D={donnees};const nf=x=>new Intl.NumberFormat('fr-FR',{{maximumFractionDigits:2}}).format(x);const esc=x=>String(x).replace(/[&<>"']/g,c=>({{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}}[c]));document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{{document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('section').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.data).classList.add('active');draw();}});function chart(id,title,cats,vals,colors,max=0){{let c=document.getElementById(id);if(!c||!c.offsetParent)return;let w=c.clientWidth,h=c.clientHeight,d=devicePixelRatio||1;c.width=w*d;c.height=h*d;let x=c.getContext('2d');x.scale(d,d);x.clearRect(0,0,w,h);let L=53,T=40,W=w-70,H=h-95,m=Math.max(max,...vals,1);x.fillStyle='#172033';x.font='12px Segoe UI';x.fillText(title,12,20);x.strokeStyle='#dbe3ee';for(let i=0;i<5;i++){{let y=T+H-H*i/4;x.beginPath();x.moveTo(L,y);x.lineTo(L+W,y);x.stroke();x.fillStyle='#64748b';x.font='10px Segoe UI';x.fillText(nf(m*i/4),3,y+3)}}cats.forEach((a,i)=>{{let gw=W/cats.length,bw=Math.min(48,gw*.6),xx=L+gw*(i+.5)-bw/2,y=T+H-H*vals[i]/m;x.fillStyle=colors[i%colors.length];x.fillRect(xx,y,bw,T+H-y);x.fillStyle='#334155';x.textAlign='center';x.fillText(nf(vals[i]),xx+bw/2,Math.max(T+10,y-5));x.fillText(a,xx+bw/2,T+H+18)}});x.textAlign='left'}}function draw(){{chart('scores','Scores à minimiser',['Blocs','Lits','Places'],[D.scores.Blocs,D.scores.Lits,D.scores.Places],['#2563eb','#7c3aed','#ea580c']);let lv=['CRITIQUE','HAUTE','MODEREE','FAIBLE'];chart('urgence','Patients par niveau',lv,lv.map(l=>D.patients.filter(p=>p.Niveau===l).length),['#b91c1c','#ea580c','#d97706','#15803d']);chart('statut','Placement', ['Placés','Non placés'],[D.patients.filter(p=>p.Statut==='PLACÉ').length,D.patients.filter(p=>p.Statut==='NON PLACÉ').length],['#15803d','#b91c1c']);}}const s=D.scores;document.getElementById('cards').innerHTML=`<div class="card"><b>Patients placés</b><div class="big">${{D.patients.filter(p=>p.Statut==='PLACÉ').length}}/${{D.patients.length}}</div><span class="muted">Vacations supplémentaires utilisées : ${{s['Vacations suppl.']}}</span></div><div class="card"><b>Score total</b><div class="big">${{nf(s.Total)}}</div><span class="muted">Bloc + lits + places</span></div><div class="card"><b>Priorité des urgences</b><div class="big">${{D.patients.filter(p=>p.Niveau==='CRITIQUE'||p.Niveau==='HAUTE').filter(p=>p.Statut==='PLACÉ').length}}/${{D.patients.filter(p=>p.Niveau==='CRITIQUE'||p.Niveau==='HAUTE').length}}</div><span class="muted">hautes et critiques placées</span></div>`;document.getElementById('detailsScores').innerHTML=`<p>Score blocs : <b>${{nf(s.Blocs)}}</b> · score lits : <b>${{nf(s.Lits)}}</b> · score places : <b>${{nf(s.Places)}}</b>.</p><p>Dans le score blocs : pénalité urgences non placées <b>${{nf(s['Pénalité urgence non placée'])}}</b> ; pénalité de retard des urgences <b>${{nf(s['Pénalité retard urgence'])}}</b>.</p>`;function patients(){{let n=document.getElementById('niveau').value,st=document.getElementById('statutFiltre').value,q=document.getElementById('q').value.toLowerCase(),a=D.patients.filter(p=>(n==='Tous'||p.Niveau===n)&&(st==='Tous'||p.Statut===st)&&(!q||Object.values(p).join(' ').toLowerCase().includes(q)));let cols=['Patient','Chirurgien','Score urgence','Niveau','Intervention','Durée','Priorité','Urgence déclarée','Statut','Créneau'];document.getElementById('tablePatients').innerHTML=`<table><thead><tr>${{cols.map(c=>`<th>${{c}}</th>`).join('')}}</tr></thead><tbody>${{a.map(p=>`<tr data-i="${{D.patients.indexOf(p)}}">${{cols.map(c=>c==='Niveau'?`<td><span class="badge ${{p.Niveau}}">${{p.Niveau}}</span></td>`:`<td>${{esc(p[c])}}</td>`).join('')}}</tr>`).join('')}}</tbody></table>`;document.querySelectorAll('#tablePatients tr[data-i]').forEach(r=>r.onclick=()=>{{let p=D.patients[r.dataset.i];document.getElementById('detailPatient').innerHTML=`<b>${{p.Patient}} — score ${{nf(p['Score urgence'])}}/100 (${{p.Niveau}})</b><br>Urgence déclarée ${{nf(p['Urgence pts'])}} + priorité ${{nf(p['Priorité pts'])}} + intervention ${{nf(p['Intervention pts'])}} + durée relative ${{nf(p['Durée relative pts'])}} + séjour ${{nf(p['Séjour pts'])}} = ${{nf(p['Score urgence'])}}`;}})}}['niveau','statutFiltre'].forEach(i=>document.getElementById(i).onchange=patients);document.getElementById('q').oninput=patients;patients();let cc=['Chirurgien','Patients','Demande min','Capacité régulière min','Ratio demande/capacité','Capacité max horizon min','Patients théoriques réguliers','Verdict'];document.getElementById('tableCoherence').innerHTML=`<table><thead><tr>${{cc.map(c=>`<th>${{c}}</th>`).join('')}}</tr></thead><tbody>${{D.coherence.map(r=>`<tr>${{cc.map(c=>`<td class="${{String(r[c]).startsWith('INCOHÉRENT')?'bad':String(r[c]).startsWith('COHÉRENT')?'ok':''}}">${{esc(r[c])}}</td>`).join('')}}</tr>`).join('')}}</tbody></table>`;window.onresize=draw;draw();</script></body></html>'''


def ouvrir_dashboard(evaluation, patients, coherence):
    import threading
    import webbrowser
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    contenu = page_dashboard(evaluation, patients, coherence).encode("utf-8")
    class Gestionnaire(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200); self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(contenu))); self.end_headers(); self.wfile.write(contenu)
        def log_message(self, *_): return
    serveur = ThreadingHTTPServer(("127.0.0.1", 0), Gestionnaire)
    url = f"http://127.0.0.1:{serveur.server_port}/"
    threading.Timer(.25, lambda: webbrowser.open(url)).start()
    print(f"\nDashboard ouvert : {url}\nAucun fichier de résultat n'est créé. Ctrl+C pour arrêter.")
    try: serveur.serve_forever()
    except KeyboardInterrupt: pass
    finally: serveur.server_close()

def optimiser_instance_benchmark(nom: str, config: dict, instance1: InstanceProbleme,
                                 vacations_base: dict[int, Vacation], rapide: bool,
                                 patients_maitres: Optional[dict[int, Patient]] = None) -> dict:
    """Résout une instance en privilégiant placement, urgence puis précocité.

    En mode complet, plusieurs trajectoires réellement différentes sont
    comparées. Une recherche plus longue n'est donc jamais autorisée à
    remplacer une solution rapide qui avait obtenu un meilleur coût.
    """
    debut = chrono.perf_counter()
    hebergement = ParametresHebergement(lits_disponibles_par_jour=14, places_ambulatoires_par_jour=10, reserve_lits=2)
    if patients_maitres is None:
        patients = construire_patients_benchmark(
            vacations_base, config["nombre_patients"], config["seed"],
        )
    else:
        patients = {
            pid: p for pid, p in patients_maitres.items()
            if pid <= config["nombre_patients"]
        }

    def resoudre_profil(nb_essais: int, temps_initial: float, temps_tour: float,
                        decalage_graine: int):
        vacations = copy.deepcopy(vacations_base)
        instance = InstanceNiveau2(
            patients, vacations, hebergement,
            {cid: c.nom for cid, c in instance1.chirurgiens.items()},
        )
        graine_solveur = config["seed"] + decalage_graine
        depart = construire_meilleure_affectation_initiale(
            instance, nb_essais=nb_essais, graine=GRAINE_PATIENTS + decalage_graine,
        )
        initial, _ = lancer_tabou_niveau2(
            instance, depart, temps_max_secondes=temps_initial,
            patience=100, nb_echanges_par_iteration=500,
            graine=graine_solveur, verbose=False,
        )
        final_candidat, evaluation_candidat = optimiser_avec_vacations_supplementaires(
            instance1, instance, initial, max_tours=10, semaines_extra=8,
            planning_repete=config["nombre_patients"] <= 100,
            temps_par_tour=temps_tour, verbose=False,
            graine=graine_solveur,
        )
        return instance, final_candidat, evaluation_candidat

    if rapide:
        profils = [(12, .6, .5, 0)]
    elif config["nombre_patients"] <= 100:
        # La reconstruction globale et la phase de secours donnent déjà des
        # solutions complètes et faibles sur 50–100 patients. Un seul départ
        # évite d'ouvrir inutilement un voisinage très volumineux.
        profils = [(16, 1.0, .8, 0)]
    else:
        # L'instance 200 conserve une trajectoire longue pour densifier le
        # planning, plus un départ court qui peut fournir un meilleur bassin.
        profils = [(18, 1.2, 1.0, 104729), (48, 22.0, 16.0, 0)]
    candidats = [resoudre_profil(*profil) for profil in profils]
    instance2, final, evaluation = min(
        candidats,
        key=lambda x: (
            x[2].violation_capacite_vacation_minutes + x[2].violation_lits + x[2].violation_places,
            x[2].patients_non_places,
            x[2].score_total,
        ),
    )
    if evaluation.patients_non_places > 0:
        # Phase de secours : l'horizon principal sert à comparer les scores,
        # puis seuls les patients encore absents justifient l'ouverture de
        # semaines plus lointaines. On évite ainsi de laisser un échec de
        # packing aléatoire décider du nombre final de patients placés.
        final, evaluation = optimiser_avec_vacations_supplementaires(
            instance1, instance2, final, max_tours=6, semaines_extra=12,
            planning_repete=config["nombre_patients"] <= 100,
            temps_par_tour=5.0 if rapide else 10.0,
            verbose=False, graine=config["seed"] + 303_303,
        )
    final, evaluation = reparer_non_places_par_chirurgien(
        instance2, final, graine=config["seed"] + 424_243,
        temps_max_secondes=2.0 if rapide else 10.0,
    )
    if evaluation.patients_non_places > 0:
        final, evaluation = garantir_placement_restant(
            instance1, instance2, final, horizon_semaines=20,
        )
    # La recherche taboue repart de la réparation ; avec les pénalités Big-M,
    # la meilleure solution conservée ne peut pas réintroduire une violation.
    if evaluation.patients_non_places == 0 and not rapide:
        final, evaluation = lancer_tabou_niveau2(
            instance2, final, temps_max_secondes=10.0, patience=120,
            nb_echanges_par_iteration=800, graine=config["seed"] + 919_919,
            verbose=False,
        )

    # Comparaison loyale : l'AG reçoit exactement la même instance finalisée
    # que le tabou (mêmes patients, chirurgiens, vacations, lits et places).
    # La solution taboue est l'élite 0 de l'AG : le score AG final est donc
    # nécessairement inférieur ou égal au score tabou de référence.
    solution_tabou = final.copy()
    evaluation_tabou = evaluer_affectation(instance2, solution_tabou)
    n = len(patients)
    if rapide:
        params_ag = ParametresGenetiquesNiveau2(
            taille_population=14, generations=12, elites=3,
            mutations_par_enfant=2, temps_max_secondes=1.5,
            graine=config["seed"] + 707_707,
        )
    else:
        params_ag = ParametresGenetiquesNiveau2(
            taille_population=36 if n <= 50 else 48 if n <= 100 else 64,
            generations=70 if n <= 50 else 90 if n <= 100 else 120,
            elites=4 if n <= 100 else 6,
            mutations_par_enfant=3 if n <= 100 else 4,
            temps_max_secondes=10.0 if n <= 50 else 18.0 if n <= 100 else 30.0,
            graine=config["seed"] + 707_707,
        )
    final, evaluation, meta_ag = lancer_algorithme_genetique_niveau2(
        instance2, solution_tabou, params_ag, verbose=False,
    )
    if cle_evaluation_niveau2(evaluation) > cle_evaluation_niveau2(evaluation_tabou):
        raise AssertionError("Régression impossible : l'élite taboue a été perdue par l'AG.")

    coherence = diagnostic_coherence_chirurgiens(instance1, instance2, semaines_extra=12)
    places = len(patients) - evaluation.patients_non_places
    return {
        "nom": nom, "patients": patients, "instance": instance2, "affectation": final,
        "evaluation": evaluation, "coherence": coherence,
        "ligne": {
            "Instance": nom, "Patients": len(patients), "Placés": places,
            "Non placés": evaluation.patients_non_places,
            "Score blocs": round(evaluation.score_blocs, 2),
            "Score lits": round(evaluation.score_lits, 2),
    places = len(patients) - evaluation.patients_non_places
    return {
        "nom": nom, "patients": patients, "instance": instance2, "affectation": final,
        "evaluation": evaluation, "evaluation_tabou": evaluation_tabou,
        "solution_tabou": solution_tabou, "meta_ag": meta_ag,
        "coherence": coherence,
        "ligne": {
            "Instance": nom, "Patients": len(patients), "Placés": places,
            "Non placés": evaluation.patients_non_places,
            "Score Tabou": round(evaluation_tabou.score_total, 2),
            "Score AG": round(evaluation.score_total, 2),
            "Gain AG": round(evaluation_tabou.score_total - evaluation.score_total, 2),
            "Gain AG (%)": round(meta_ag["gain_pct"], 3),
            "Score blocs": round(evaluation.score_blocs, 2),
            "Score lits": round(evaluation.score_lits, 2),
            "Score places": round(evaluation.score_places, 2),
            "Score total": round(evaluation.score_total, 2),
            "Dépassement bloc (min)": round(evaluation.violation_capacite_vacation_minutes, 2),
            "Violation lits": evaluation.violation_lits,
            "Violation places": evaluation.violation_places,
            "Contraintes": "OK" if (
                evaluation.violation_capacite_vacation_minutes == 0
                and evaluation.violation_lits == 0
                and evaluation.violation_places == 0
            ) else "À CORRIGER",
            "Vacations supplémentaires": evaluation.nb_vacations_supp_utilisees,
            "Urgence haute/critique placée": sum(
                p.score_urgence >= 45 and final.affectations[p.id] is not None for p in patients.values()
            ),
            "Urgence haute/critique": sum(p.score_urgence >= 45 for p in patients.values()),
            "Temps (s)": round(chrono.perf_counter() - debut, 1),
        },
    }


def planning_visuel_instance(resultat: dict) -> list[dict]:
    """Vacations finales et patients, structurés pour la vue semaine du site."""
    instance2: InstanceNiveau2 = resultat["instance"]
    affectation: AffectationPatients = resultat["affectation"]
    par_vacation: dict[int, list[Patient]] = {}
    for pid, vid in affectation.affectations.items():
        if vid is not None:
            par_vacation.setdefault(vid, []).append(instance2.patients[pid])
    lignes = []
    for vacation in sorted(instance2.vacations.values(),
                           key=lambda v: (v.semaine_decalage, v.jour, v.salle_id, v.heure_debut)):
        patients = sorted(par_vacation.get(vacation.id, []),
                          key=lambda p: (-p.score_urgence, -p.duree_bloc_minutes))
        if not patients:
            continue
        charge = sum(p.duree_bloc_minutes for p in patients)
        capacite = capacite_effective_vacation(vacation)
        lignes.append({
            "Instance": resultat["nom"],
            "Semaine": vacation.semaine_decalage,
            "Jour": JOURS_FR[vacation.jour.weekday()],
            "Ordre jour": vacation.jour.weekday(),
            "Date": vacation.jour.strftime("%d/%m/%Y"),
            "Salle": vacation.salle_id,
            "Vacation": vacation.id,
            "Début": vacation.heure_debut.strftime("%H:%M"),
            "Fin": vacation.heure_fin.strftime("%H:%M"),
            "Chirurgien": instance2.noms_chirurgiens.get(vacation.chirurgien_id, str(vacation.chirurgien_id)),
            "Supplémentaire": vacation.supplementaire,
            "Charge": charge,
            "Capacité": round(capacite, 1),
            "Occupation": round(100 * charge / capacite, 1) if capacite else 0.0,
            "Patients": [{
                "nom": p.nom, "duree": p.duree_bloc_minutes,
                "score": p.score_urgence, "niveau": niveau_urgence(p.score_urgence),
                "intervention": p.type_intervention,
            } for p in patients],
        })
    return lignes


def page_dashboard_instances(resultats: list[dict]) -> str:
    lignes = [r["ligne"] for r in resultats]
    patients = [dict(ligne, Instance=r["nom"]) for r in resultats
                for ligne in lignes_patients_dashboard(r["instance"], r["affectation"])]
    coherence = [dict(ligne, Instance=r["nom"]) for r in resultats for ligne in r["coherence"]]
    planning = [vacation for resultat in resultats for vacation in planning_visuel_instance(resultat)]
    sources = resultats[0].get("sources", {}) if resultats else {}
    data = json.dumps({"lignes": lignes, "patients": patients, "coherence": coherence,
                       "planning": planning, "sources": sources},
