def afficher_rapport_niveau2_console(resultat: dict, detail: bool = True) -> None:
    nom = resultat["nom"]
    instance2: InstanceNiveau2 = resultat["instance"]
    affectation: AffectationPatients = resultat["affectation"]
    evaluation: EvaluationAffectation = resultat["evaluation"]
    verification = verifier_capacites_finales(instance2, affectation)
    par_vacation = _occupation_vacations(instance2, affectation)
    occ_lits, occ_places = calculer_occupation_par_jour(instance2, affectation)
    total = len(instance2.patients)
    places = total - evaluation.patients_non_places

    reports = [
        instance2.vacations[vid].semaine_decalage
        for vid in affectation.affectations.values() if vid is not None
    ]
    nb_reportes = sum(semaine > 0 for semaine in reports)
    semaines_total = sum(reports)
    report_pondere = sum(
        instance2.vacations[vid].semaine_decalage * max(1, instance2.patients[pid].priorite)
        for pid, vid in affectation.affectations.items() if vid is not None
    )

    print("\n" + "=" * 104)
    print(f"RAPPORT DETAILLE — instance « {nom} »")
    print("=" * 104)
    print(f"{total} patients, {_semaine_max_utilisee(resultat)} semaine(s) effectivement utilisée(s).")
    print(f"\nScore total : {evaluation.score_total:.2f}")
    print(f"  référence Tabou          : {resultat['evaluation_tabou'].score_total:.2f}")
    print(f"  résultat AG              : {evaluation.score_total:.2f}")
    print(f"  amélioration AG          : {resultat['meta_ag']['gain_absolu']:.2f} "
          f"({resultat['meta_ag']['gain_pct']:.3f} %)")
    print(f"  données identiques       : {'oui' if resultat['meta_ag']['meme_instance'] else 'NON'}")
    print(f"  score blocs              : {evaluation.score_blocs:.2f}")
    print(f"  score lits               : {evaluation.score_lits:.2f}")
    print(f"  score places             : {evaluation.score_places:.2f}")
    print(f"  patients planifiés       : {places} / {total}")
    print(f"  patients non planifiés   : {evaluation.patients_non_places} / {total}")
    print(f"  patients reportés        : {nb_reportes} / {places} "
          f"(total {semaines_total} semaine(s), pondéré par priorité : {report_pondere})")
    print(f"  vacations supplémentaires: {evaluation.nb_vacations_supp_utilisees}")
    print(f"  urgences hautes/critiques: {resultat['ligne']['Urgence haute/critique placée']} / "
          f"{resultat['ligne']['Urgence haute/critique']}")
    print("Vérification indépendante des capacités :")
    print(f"  remplissage max : bloc {verification['taux_max_bloc']:.0f} % | "
          f"lits {verification['taux_max_lits']:.0f} % | places {verification['taux_max_places']:.0f} %")
    print(f"  -> {'OK : aucune capacité dépassée' if verification['ok'] else 'ERREUR : capacité dépassée'}")

    print("Attente moyenne (en semaines) par priorité :")
    for priorite in (4, 3, 2, 1):
        valeurs = [
            instance2.vacations[vid].semaine_decalage
            for pid, vid in affectation.affectations.items()
            if vid is not None and instance2.patients[pid].priorite == priorite
        ]
        if valeurs:
            print(f"  priorité {priorite} : {sum(valeurs) / len(valeurs):.2f}  "
                  f"({len(valeurs)} patients planifiés)")

    if not detail:
        return

    print("\n--- Tableau 1 : vacations utilisées (une ligne par vacation et par semaine) ---")
    print(f"  {'Vac':>4} {'Sem':>3} {'Jour':<22} {'Chir.':<8} {'Amb.':>4} {'Hosp.':>5} "
          f"{'Charge':>7} {'Cap.utile':>9} {'Taux':>6} {'Type':<7}")
