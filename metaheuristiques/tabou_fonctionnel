              f"{('+' + str(vacation.semaine_decalage) + ' sem'):>7} "
              f"{libelle_jour(admission):<22} {libelle_jour(vacation.jour):<22} "
              f"{libelle_jour(sortie):<22} {patient.duree_bloc_minutes:>5}")


