GRAINE_PATIENTS = GRAINE_ETUDE + 1
MARGE_ALEA_VACATION = 0.10

# Les trois dépassements sont traités comme des contraintes dures par une
# pénalité Big-M. Tant qu'une solution sans dépassement existe, aucune baisse
# des autres coûts ne peut donc compenser une violation de capacité.
POIDS = {
    "non_place": 8000, "lit": 1_000_000, "place": 1_000_000,
    "depassement_vac": 1_000_000,
    # Cout comparable et cumulatif : une instance plus grande consomme plus de
    # minutes, de journees d'hebergement et de vacations supplementaires.
    # L'inoccupation et la variance restent des leviers d'optimisation, mais ne
    # doivent plus inverser artificiellement Petite/Moyenne/Grande.
    "bloc_inoccupe": 0.05,
    "minute_programmee": 0.08,
    "vacation_supplementaire": 20.0,
    "jour_lit": 1.0,
    "jour_place": 1.0,
    "var_lits": 5.0,
    "var_places": 5.0,
}

SPECIALITES_PAR_CHIRURGIEN = {
    1: "Orthopédie", 2: "Digestif", 3: "ORL", 4: "Urologie",
    5: "Gynécologie", 6: "Vasculaire", 7: "Ophtalmologie", 8: "Chirurgie générale",
}
# La non-affectation d'un patient prioritaire et son retard deviennent plus
# coûteux. Ces deux termes restent rattachés au score « blocs » : ils portent
# sur l'ordre d'affectation au bloc, non sur l'hébergement.
POIDS_URGENCE_NON_PLACEE = 150.0
# Le retard reste un critère de départage pour conserver les urgences tôt,
# mais ne doit pas masquer les coûts hospitaliers blocs/lits/places. À 3.0,
# cette pénalité artificielle représentait l'essentiel du score de l'instance
# 50 patients et rendait l'objectif « sous 3 000 » mathématiquement trompeur.
POIDS_RETARD_URGENCE = 0.02

TYPES_INTERVENTION = ["ARTHROSCOPIE", "CHIRURGIE_STANDARD", "PROTHESE", "CHIRURGIE_COMPLEXE"]
POINTS_TYPE_INTERVENTION = {
    "ARTHROSCOPIE": 0.0, "CHIRURGIE_STANDARD": 4.0,
    "PROTHESE": 7.0, "CHIRURGIE_COMPLEXE": 10.0,
}
POINTS_PRIORITE = {1: 0.0, 2: 8.0, 3: 16.0, 4: 24.0}


def niveau_urgence(score: float) -> str:
    if score >= 70:
        return "CRITIQUE"
    if score >= 45:
        return "HAUTE"
    if score >= 25:
        return "MODEREE"
    return "FAIBLE"


def attribuer_scores_urgence(patients: dict[int, "Patient"]) -> dict[int, "Patient"]:
    """Score 0–100 individuel, relatif à l'intervention.

    Formule transparente : urgence déclarée (0/45) + priorité (0/8/16/24)
    + type (0–10) + percentile de durée DANS LE MÊME TYPE (0–12) + séjour
    prévu (0–9). Ce score sert uniquement à prioriser cette simulation.
    """
    durees: dict[str, list[int]] = {}
    for patient in patients.values():
        durees.setdefault(patient.type_intervention, []).append(patient.duree_bloc_minutes)
    for valeurs in durees.values():
        valeurs.sort()
    resultat = {}
    for pid, patient in patients.items():
        valeurs = durees[patient.type_intervention]
        if len(valeurs) == 1:
            percentile = 0.5
        else:
            lo = valeurs.index(patient.duree_bloc_minutes)
            hi = len(valeurs) - 1 - valeurs[::-1].index(patient.duree_bloc_minutes)
            percentile = (lo + hi) / 2 / (len(valeurs) - 1)
        u = 45.0 if patient.urgence else 0.0
        p = POINTS_PRIORITE.get(patient.priorite, 0.0)
        i = POINTS_TYPE_INTERVENTION.get(patient.type_intervention, 4.0)
        d = round(12.0 * percentile, 2)
        s = 3.0 * min(3, patient.nuits_pre_op + patient.nuits_post_op)
        resultat[pid] = replace(patient, score_urgence=round(min(100.0, u + p + i + d + s), 2),
                                 urgence_points=u, priorite_points=p, intervention_points=i,
                                 duree_relative_points=d, sejour_points=s)
    return resultat


