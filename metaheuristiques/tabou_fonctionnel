                 f"{patient.score_urgence:>7.1f} {chirurgien:<8} ")
        if vacation_id is None:
            print(debut + f"{'-':>4} {'-':>5} {'-':>7} NON PLANIFIÉ")
            continue
        vacation = instance2.vacations[vacation_id]
        jours = jours_occupation(patient, vacation)
        admission = vacation.jour if patient.ambulatoire else min(jours)
        sortie = vacation.jour if patient.ambulatoire else max(jours) + timedelta(days=1)
