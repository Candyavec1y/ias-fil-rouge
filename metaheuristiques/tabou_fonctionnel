              f"{charge:>7.0f} {capacite:>9.0f} {100 * charge / capacite:>5.0f}% "
              f"{'SUPPL.' if vacation.supplementaire else 'REG.':<7}")

    h = instance2.parametres_hebergement
    cap_lits = h.lits_disponibles_par_jour - h.reserve_lits
    cap_places = h.places_ambulatoires_par_jour
    print("\n--- Tableau 2 : jours occupés (occupation / capacité) ---")
    print(f"  {'Jour':<22} {'Lits occ./cap.':>16} {'Places occ./cap.':>18}")
    for jour in sorted(set(occ_lits) | set(occ_places)):
