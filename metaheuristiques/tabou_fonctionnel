# ALGORITHME GENETIQUE NIVEAU 2 — MEMES DONNEES ET MEME SCORE QUE TABOU
# ----------------------------------------------------------------------

@dataclass(frozen=True)
class ParametresGenetiquesNiveau2:
    taille_population: int = 40
    generations: int = 80
    taux_croisement: float = 0.90
    taux_mutation: float = 0.85
    elites: int = 4
    taille_tournoi: int = 4
    mutations_par_enfant: int = 3
    temps_max_secondes: float = 15.0
    graine: int = GRAINE_PATIENTS + 606_060


def cle_evaluation_niveau2(evaluation: EvaluationAffectation) -> tuple:
    """Ordre commun aux deux méthodes : contraintes, placement, puis coût."""
    return (
        evaluation.violation_capacite_vacation_minutes
        + evaluation.violation_lits
        + evaluation.violation_places,
        evaluation.patients_non_places,
        evaluation.score_total,
    )


def lancer_algorithme_genetique_niveau2(
    instance2: InstanceNiveau2,
    solution_tabou: AffectationPatients,
    parametres: ParametresGenetiquesNiveau2 | None = None,
    verbose: bool = False,
) -> tuple[AffectationPatients, EvaluationAffectation, dict]:
    """AG mémétique comparé loyalement au tabou sur LA MEME instance.

    Les deux méthodes partagent sans copie ni recalibrage : patients,
    chirurgiens, vacations, lits, places, marges et fonction de coût.

    La solution taboue est injectée comme premier individu et protégée par
    élitisme. Par conséquent, l'AG ne peut jamais rendre un score final plus
    mauvais que celui du tabou. Les croisements partent d'un parent faisable
    et n'acceptent un gène du second parent que si toutes les capacités restent
    respectées. Les mutations utilisent des déplacements et échanges faisables.
    """
    p = parametres or ParametresGenetiquesNiveau2()
    rng = random.Random(p.graine)

    def empreinte_instance() -> tuple:
        """Empreinte déterministe de toutes les données partagées Tabou/AG."""
        h = instance2.parametres_hebergement
        patients_signature = tuple(sorted(
            (pid, patient.chirurgien_id, patient.duree_bloc_minutes,
             patient.ambulatoire, patient.nuits_pre_op, patient.nuits_post_op,
             patient.type_intervention, patient.priorite, patient.urgence,
             patient.score_urgence)
            for pid, patient in instance2.patients.items()
        ))
        vacations_signature = tuple(sorted(
            (vid, vacation.chirurgien_id, vacation.salle_id, vacation.jour,
             vacation.heure_debut, vacation.heure_fin, vacation.creneaux_ids,
             vacation.supplementaire, vacation.semaine_decalage)
            for vid, vacation in instance2.vacations.items()
        ))
        return (
            patients_signature,
            vacations_signature,
            tuple(sorted(instance2.noms_chirurgiens.items())),
            h.lits_disponibles_par_jour,
            h.reserve_lits,
            h.places_ambulatoires_par_jour,
            tuple(sorted(POIDS.items())),
            POIDS_URGENCE_NON_PLACEE,
            POIDS_RETARD_URGENCE,
        )

    empreinte_avant = empreinte_instance()
    pids = sorted(instance2.patients)
    compatibles = {
        pid: [v.id for v in vacations_compatibles(instance2, instance2.patients[pid])]
        for pid in pids
    }
    patients_par_chirurgien: dict[int, list[int]] = {}
    for pid in pids:
        patients_par_chirurgien.setdefault(instance2.patients[pid].chirurgien_id, []).append(pid)

    cache: dict[tuple, EvaluationAffectation] = {}

    def chromosome(individu: dict[int, Optional[int]]) -> tuple:
        return tuple(individu.get(pid) for pid in pids)

    def evaluer(individu: dict[int, Optional[int]]) -> EvaluationAffectation:
        cle = chromosome(individu)
        evaluation = cache.get(cle)
        if evaluation is None:
            evaluation = evaluer_affectation(instance2, AffectationPatients(dict(individu)))
            cache[cle] = evaluation
        return evaluation

    def etat_faisable(etat: EtatNiveau2) -> bool:
        return (
            etat.depassement <= 1e-9
            and etat.lits.violation == 0
            and etat.places.violation == 0
            and etat.non_places == 0
        )

    def tenter_deplacement(etat: EtatNiveau2, pid: int, nouvelle: int) -> bool:
        ancienne = etat.aff[pid]
        if nouvelle == ancienne:
            return False
        etat.deplacer(pid, nouvelle)
        if etat_faisable(etat):
            return True
        etat.deplacer(pid, ancienne)
        return False

    def tenter_echange(etat: EtatNiveau2, a: int, b: int) -> bool:
        va, vb = etat.aff[a], etat.aff[b]
        if va is None or vb is None or va == vb:
            return False
        # Les patients sont choisis chez le même chirurgien : chaque vacation
        # reçue reste donc compatible avec le patient échangé.
        etat.deplacer(a, vb)
        etat.deplacer(b, va)
        if etat_faisable(etat):
            return True
        etat.deplacer(b, vb)
        etat.deplacer(a, va)
        return False

    def mutation(individu: dict[int, Optional[int]], intensite: int | None = None) -> dict[int, Optional[int]]:
        etat = EtatNiveau2(instance2, individu)
        nb = intensite if intensite is not None else rng.randint(1, max(1, p.mutations_par_enfant))
        for _ in range(nb):
            if rng.random() < 0.68:
                pid = rng.choice(pids)
                options = [vid for vid in compatibles[pid] if vid != etat.aff[pid]]
                rng.shuffle(options)
                # La moitié des mutations est dirigée vers le meilleur mouvement
                # faisable échantillonné ; l'autre moitié entretient la diversité.
                if rng.random() < 0.55 and options:
                    ancienne = etat.aff[pid]
                    candidats = []
                    for vid in options[: min(12, len(options))]:
                        etat.deplacer(pid, vid)
                        if etat_faisable(etat):
                            candidats.append((etat.score(), vid))
                        etat.deplacer(pid, ancienne)
                    if candidats:
                        etat.deplacer(pid, min(candidats)[1])
                else:
                    for vid in options[: min(12, len(options))]:
                        if tenter_deplacement(etat, pid, vid):
                            break
            else:
                groupes = [g for g in patients_par_chirurgien.values() if len(g) >= 2]
                if groupes:
                    groupe = rng.choice(groupes)
                    for _ in range(8):
                        a, b = rng.sample(groupe, 2)
                        if tenter_echange(etat, a, b):
                            break
        return dict(etat.aff)

    def croiser(parent1: dict[int, Optional[int]],
                parent2: dict[int, Optional[int]]) -> dict[int, Optional[int]]:
        # On part d'un parent intégralement faisable. L'apport du second parent
        # est testé gène par gène ; aucun enfant invalide n'entre en population.
        etat = EtatNiveau2(instance2, parent1)
        ordre = pids.copy()
        rng.shuffle(ordre)
        for pid in ordre:
            if rng.random() < 0.50:
                gene = parent2.get(pid)
                if gene is not None and gene in compatibles[pid]:
                    tenter_deplacement(etat, pid, gene)
        return dict(etat.aff)

    def tournoi(population: list[dict[int, Optional[int]]],
                evaluations: list[EvaluationAffectation]) -> dict[int, Optional[int]]:
        indices = rng.sample(range(len(population)), min(p.taille_tournoi, len(population)))
        meilleur = min(indices, key=lambda i: cle_evaluation_niveau2(evaluations[i]))
        return population[meilleur]

    reference = dict(solution_tabou.affectations)
    evaluation_tabou = evaluer(reference)
    if cle_evaluation_niveau2(evaluation_tabou)[:2] != (0.0, 0):
        raise ValueError("La solution de référence taboue doit être complète et faisable avant le lancement de l'AG.")

    population = [reference]
    while len(population) < max(2, p.taille_population):
        # Plusieurs intensités créent une population diverse sans changer les
        # données ni relâcher les capacités.
        population.append(mutation(reference, rng.randint(1, max(2, p.mutations_par_enfant * 3))))

    meilleur = reference
    meilleure_evaluation = evaluation_tabou
    historique = [evaluation_tabou.score_total]
    t0 = chrono.perf_counter()
    generations_executees = 0

    for generation in range(1, p.generations + 1):
        if chrono.perf_counter() - t0 >= p.temps_max_secondes:
            break
        evaluations = [evaluer(individu) for individu in population]
        ordre = sorted(range(len(population)), key=lambda i: cle_evaluation_niveau2(evaluations[i]))
        candidat, evaluation_candidate = population[ordre[0]], evaluations[ordre[0]]
        if cle_evaluation_niveau2(evaluation_candidate) < cle_evaluation_niveau2(meilleure_evaluation):
            meilleur = dict(candidat)
            meilleure_evaluation = evaluation_candidate

        nouvelle_population = [dict(population[i]) for i in ordre[: max(1, p.elites)]]
        # La référence taboue reste explicitement dans chaque génération.
        if chromosome(reference) not in {chromosome(x) for x in nouvelle_population}:
            nouvelle_population[0] = dict(reference)
        while len(nouvelle_population) < p.taille_population:
            parent1 = tournoi(population, evaluations)
            parent2 = tournoi(population, evaluations)
            enfant = croiser(parent1, parent2) if rng.random() < p.taux_croisement else dict(parent1)
            if rng.random() < p.taux_mutation:
                enfant = mutation(enfant)
            nouvelle_population.append(enfant)
        population = nouvelle_population
        generations_executees = generation
        historique.append(meilleure_evaluation.score_total)
        if verbose and (generation == 1 or generation % 10 == 0):
            print(f"    génération {generation:>3} | meilleur AG = {meilleure_evaluation.score_total:,.2f}")

    # Comparaison finale explicite avec l'élite taboue : garantie anti-régression.
    if cle_evaluation_niveau2(evaluation_tabou) < cle_evaluation_niveau2(meilleure_evaluation):
        meilleur, meilleure_evaluation = reference, evaluation_tabou
    solution = AffectationPatients(dict(meilleur))
    verification = evaluer_affectation(instance2, solution)
    empreinte_apres = empreinte_instance()
    donnees_identiques = empreinte_avant == empreinte_apres
    if not donnees_identiques:
        raise AssertionError("L'algorithme génétique a modifié les données communes avec le tabou.")
    meta = {
        "score_tabou": evaluation_tabou.score_total,
        "score_ag": verification.score_total,
        "gain_absolu": evaluation_tabou.score_total - verification.score_total,
        "gain_pct": (
            100.0 * (evaluation_tabou.score_total - verification.score_total) / evaluation_tabou.score_total
            if evaluation_tabou.score_total else 0.0
        ),
        "generations": generations_executees,
        "population": p.taille_population,
        "temps_s": chrono.perf_counter() - t0,
        "historique": historique,
        "meme_instance": donnees_identiques,
    }
    return solution, verification, meta


